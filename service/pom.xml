<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-observability</artifactId>
        <version>2026.902.223958</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The whole telemetry context, in one module: `eu.wohlben.qits.telemetry.{api,control,dto,
         mcp,error}`. Unlike every other qits context there is no domain/service split, because
         there was none to replay — migration-plan.md §3.6: telemetry is the one domain whose
         business logic already lived entirely in the monorepo's `service` module. The buffer is
         in-memory, so the usual reason for a framework-free `domain` jar (entities + persistence
         + its own Flyway lineage) does not apply.

         DIRECTORY vs ARTIFACT: the directory is `service/` because the replayed git history is
         anchored to service/src/**; the artifactId is `qits-telemetry` because that is the settled
         name for the module inside qits-observability (superproject commit 1919396). The two are
         allowed to disagree — directories are load-bearing here, artifactIds are not.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the OTLP receiver, the REST routes and the MCP tools" —
         on the reasoning that packaging it would need an auth variant, a webui and a main class.
         Each of those has since stopped being true: authentication terminates at qits-gateway and
         this module reads a header (see security/), the webui is now this context's own — the
         qits-spa-observability submodule at src/main/webui, built into the artifact by Quinoa — and
         Quarkus supplies the main class. What remained was a receiver that no process could start
         and the gateway had nothing to route to.

         See migration-deployables-plan.md in the superproject; the same change is owed to the other
         five extracted services, which are still library JARs for the same lapsed reason. -->
    <artifactId>qits-telemetry</artifactId>
    <name>qits-observability :: telemetry</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <!-- /<segment>/q/health/ready - the readiness endpoint qits-cd's health gate curls;
                 the deployment convention every service answers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export — this service is both receiver and sender, see the telemetry section
                 of application.properties for why that is not circular. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity + the HttpAuthenticationMechanism SPI, for the single thing this
                 service does about auth: read qits-gateway's X-Qits-User header into an identity
                 (see security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-auth-core</artifactId>
        </dependency>
        <dependency>
            <!-- The JSON query surface (WorkspaceTelemetryController) and the protobuf ingest
                 routes (OtelReceiverResource). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- @Operation(hidden = true) on the wire-protocol endpoints. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP wire-format bindings for the in-process receiver (OtelReceiverResource).
                 Pulls protobuf-java transitively. Version pinned in the parent. -->
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
        </dependency>
        <dependency>
            <!-- MCP server (Streamable HTTP + legacy SSE): the telemetry tools mount on the
                 "repository" server. Version pinned in the parent. -->
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
        </dependency>
        <dependency>
            <!-- Builds the Angular SPA in src/main/webui (the qits-spa-observability submodule)
                 during augmentation and serves the bundle as static resources from this process,
                 so /observability is one deployable rather than a service plus a web server.
                 Version pinned in the parent.

                 NOTE this makes node/npm a BUILD prerequisite of `mvn package` — see the Quinoa
                 block in application.properties for what that does and does not cost the suite. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The user-story framework: the story catalogue under src/test/java/…/telemetry/stories
                 (plus TelemetryBootstrapIT, which owns the boot) is written as @UserStory methods,
                 so the packaged round-trip proof doubles as documentation — steps, notes and an
                 OBSERVED network diagram per story, emitted under target/userstories/. Every story
                 is browserless (an Interactions parameter and no Flow), so the transitive
                 Playwright never launches anything and no browser is downloaded. Version pinned in
                 the parent.

                 NO qits-service-mock. This module used to depend on it for the generic MockService
                 standing in for the PARENT qits-observability; stories/support/StoryParent replaced
                 it, and the dependency went with it. A canned-JSON mock keyed on an exact
                 METHOD+path pair cannot answer OTLP protobuf, cannot be armed from a story method's
                 classloader (an attached handle refuses to stub), and therefore cannot express the
                 stories this catalogue is mostly made of: a parent that is slow, refusing or
                 silent. StoryParent speaks the collector surface with the same proto bindings the
                 receiver decodes with, and arms its faults through files the way every sibling
                 catalogue does.

                 It does NOT replace OtelStubTestResource either. That one is a real HttpServer
                 capturing request BODIES, which is how OtelTeeTest proves byte-verbatim relay
                 against the suite's JVM; StoryParent records method, target, status and the two
                 relayed headers, which is what a userflow's observed network edge is made of. The
                 two prove different halves. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-userflows</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar: `qits-observability` is a
                     process that receives OTLP and answers queries over what it received, and it
                     has to be runnable on its own for the gateway to have anything to route to.
                     `<packaging>quarkus</packaging>` above is what says so: it binds generate-code,
                     generate-code-tests and build into the lifecycle, so augmentation is not an
                     execution someone can misplace. It was one — and a sibling repo has already had
                     such a block silently not apply, under a `<build>` whose `<testResources>` came
                     first, while `mvn verify` stayed green regardless (the qits-projects finding in
                     migration-deployables-plan.md). A packaging type cannot fail that way: without
                     this `<extensions>true</extensions>` the build stops at "Unknown packaging:
                     quarkus". Version comes from the root pom's pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- How @QuarkusIntegrationTest finds the compiled binary in a
                                     `-Dnative` build; without it the native run has nothing to
                                     launch. The name is `quarkus.package.output-name` from
                                     application.properties, NOT the maven finalName — with an
                                     output-name set, target/${finalName}-runner does not exist, so
                                     the two spellings have to move together or a native IT starts
                                     nothing and passes. -->
                                <native.image.path>${project.build.directory}/qits-observability</native.image.path>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build (the same profile qits-gateway and the workspace-daemon carry):
             `-Dnative` disables the fast-jar and enables the native image. It lives in THIS module
             and not the root pom because only this module is an application — the root is a
             packaging pom with nothing to native-compile. skipITs flips with it, so a `-Dnative`
             build runs OtelReceiverIT against the binary instead of skipping past it: protobuf
             decoding is exactly the thing that can be green on the JVM and broken in the image, and
             an IT that never launches would hide that. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
